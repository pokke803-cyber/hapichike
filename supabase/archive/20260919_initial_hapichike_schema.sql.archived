begin;

create extension if not exists pgcrypto;

create table public.households (
  id uuid primary key default gen_random_uuid(),
  name text not null check (char_length(btrim(name)) between 1 and 100),
  owner_user_id uuid not null references auth.users(id) on delete restrict,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table public.household_members (
  id uuid primary key default gen_random_uuid(),
  household_id uuid not null references public.households(id) on delete cascade,
  user_id uuid not null references auth.users(id) on delete cascade,
  role text not null check (role in ('owner', 'parent')),
  created_at timestamptz not null default now(),
  unique (household_id, user_id)
);

create table public.children (
  id uuid primary key default gen_random_uuid(),
  household_id uuid not null references public.households(id) on delete cascade,
  name text not null check (char_length(btrim(name)) between 1 and 100),
  icon text,
  display_order integer not null default 0 check (display_order >= 0),
  is_active boolean not null default true,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table public.child_balances (
  child_id uuid primary key references public.children(id) on delete cascade,
  tickets integer not null default 0 check (tickets >= 0),
  star_coins integer not null default 0 check (star_coins >= 0),
  sweets_pay integer not null default 0 check (sweets_pay >= 0),
  toy_pay integer not null default 0 check (toy_pay >= 0),
  game_pay integer not null default 0 check (game_pay >= 0),
  happy_chance_cards integer not null default 0 check (happy_chance_cards >= 0),
  updated_at timestamptz not null default now()
);

create table public.tasks (
  id uuid primary key default gen_random_uuid(),
  household_id uuid not null references public.households(id) on delete cascade,
  title text not null check (char_length(btrim(title)) between 1 and 200),
  description text,
  icon text,
  category text,
  difficulty text,
  reward_type text not null check (reward_type in ('ticket', 'starCoin')),
  ticket_reward integer not null default 0 check (ticket_reward >= 0),
  star_coin_reward integer not null default 0 check (star_coin_reward >= 0),
  is_active boolean not null default true,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  check (
    (reward_type = 'ticket' and ticket_reward > 0 and star_coin_reward = 0)
    or (reward_type = 'starCoin' and star_coin_reward > 0 and ticket_reward = 0)
  )
);

create table public.today_tasks (
  id uuid primary key default gen_random_uuid(),
  child_id uuid not null references public.children(id) on delete cascade,
  task_id uuid not null references public.tasks(id) on delete restrict,
  status text not null default 'pending' check (status in ('pending', 'completed', 'cancelled')),
  reward_granted boolean not null default false,
  created_at timestamptz not null default now(),
  completed_at timestamptz,
  check (status <> 'completed' or completed_at is not null),
  check (not reward_granted or status = 'completed')
);

create table public.help_jobs (
  id uuid primary key default gen_random_uuid(),
  household_id uuid not null references public.households(id) on delete cascade,
  title text not null check (char_length(btrim(title)) between 1 and 200),
  description text,
  icon text,
  category text,
  reward_type text not null check (reward_type in ('ticket', 'starCoin')),
  ticket_reward integer not null default 0 check (ticket_reward >= 0),
  star_coin_reward integer not null default 0 check (star_coin_reward >= 0),
  capacity integer not null default 1 check (capacity > 0),
  deadline_at timestamptz,
  require_parent_approval boolean not null default true,
  status text not null default 'open' check (status in ('open', 'full', 'expired', 'closed', 'completed', 'cancelled')),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  check (
    (reward_type = 'ticket' and ticket_reward > 0 and star_coin_reward = 0)
    or (reward_type = 'starCoin' and star_coin_reward > 0 and ticket_reward = 0)
  )
);

create table public.help_job_applicants (
  id uuid primary key default gen_random_uuid(),
  job_id uuid not null references public.help_jobs(id) on delete cascade,
  child_id uuid not null references public.children(id) on delete cascade,
  status text not null default 'applied' check (status in ('applied', 'completed', 'approved', 'rejected', 'cancelled')),
  applied_at timestamptz not null default now(),
  completed_at timestamptz,
  approved_at timestamptz,
  reward_granted boolean not null default false,
  unique (job_id, child_id),
  check (status <> 'completed' or completed_at is not null),
  check (status <> 'approved' or approved_at is not null),
  check (not reward_granted or status = 'approved')
);

create table public.reward_logs (
  id uuid primary key default gen_random_uuid(),
  household_id uuid not null references public.households(id) on delete cascade,
  child_id uuid references public.children(id) on delete set null,
  type text not null check (char_length(btrim(type)) between 1 and 100),
  title text,
  message text,
  amount integer,
  metadata jsonb not null default '{}'::jsonb check (jsonb_typeof(metadata) = 'object'),
  created_at timestamptz not null default now()
);

create table public.parent_settings (
  household_id uuid primary key references public.households(id) on delete cascade,
  parent_email text,
  audio_enabled boolean not null default true,
  bgm_enabled boolean not null default true,
  sfx_enabled boolean not null default true,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create index household_members_user_id_idx on public.household_members(user_id);
create index children_household_order_idx on public.children(household_id, display_order);
create index tasks_household_active_idx on public.tasks(household_id, is_active);
create index today_tasks_child_status_created_idx on public.today_tasks(child_id, status, created_at desc);
create index today_tasks_task_id_idx on public.today_tasks(task_id);
create index help_jobs_household_status_deadline_idx on public.help_jobs(household_id, status, deadline_at);
create index help_job_applicants_child_idx on public.help_job_applicants(child_id);
create index reward_logs_household_created_idx on public.reward_logs(household_id, created_at desc);
create index reward_logs_child_created_idx on public.reward_logs(child_id, created_at desc);

create or replace function public.set_updated_at()
returns trigger
language plpgsql
security invoker
set search_path = ''
as $$
begin
  new.updated_at = now();
  return new;
end;
$$;

create trigger households_set_updated_at
before update on public.households
for each row execute function public.set_updated_at();

create trigger children_set_updated_at
before update on public.children
for each row execute function public.set_updated_at();

create trigger child_balances_set_updated_at
before update on public.child_balances
for each row execute function public.set_updated_at();

create trigger tasks_set_updated_at
before update on public.tasks
for each row execute function public.set_updated_at();

create trigger help_jobs_set_updated_at
before update on public.help_jobs
for each row execute function public.set_updated_at();

create trigger parent_settings_set_updated_at
before update on public.parent_settings
for each row execute function public.set_updated_at();

create or replace function public.prevent_household_owner_change()
returns trigger
language plpgsql
security invoker
set search_path = ''
as $$
begin
  if new.owner_user_id <> old.owner_user_id then
    raise exception 'household owner_user_id cannot be changed';
  end if;
  return new;
end;
$$;

create trigger households_prevent_owner_change
before update on public.households
for each row execute function public.prevent_household_owner_change();

create or replace function public.prevent_household_id_change()
returns trigger
language plpgsql
security invoker
set search_path = ''
as $$
begin
  if new.household_id <> old.household_id then
    raise exception 'household_id cannot be changed';
  end if;
  return new;
end;
$$;

create trigger household_members_prevent_household_change
before update of household_id on public.household_members
for each row execute function public.prevent_household_id_change();

create or replace function public.validate_household_member_role()
returns trigger
language plpgsql
security definer
set search_path = ''
as $$
declare
  household_owner_user_id uuid;
begin
  select h.owner_user_id into household_owner_user_id
  from public.households h
  where h.id = new.household_id;

  if household_owner_user_id is null then
    raise exception 'household not found';
  end if;
  if new.role = 'owner' and new.user_id <> household_owner_user_id then
    raise exception 'only the household owner_user_id may have the owner role';
  end if;
  if new.role <> 'owner' and new.user_id = household_owner_user_id then
    raise exception 'the household owner_user_id must keep the owner role';
  end if;
  return new;
end;
$$;

create trigger household_members_validate_role
before insert or update of household_id, user_id, role on public.household_members
for each row execute function public.validate_household_member_role();

create trigger children_prevent_household_change
before update of household_id on public.children
for each row execute function public.prevent_household_id_change();

create trigger tasks_prevent_household_change
before update of household_id on public.tasks
for each row execute function public.prevent_household_id_change();

create trigger help_jobs_prevent_household_change
before update of household_id on public.help_jobs
for each row execute function public.prevent_household_id_change();

create trigger reward_logs_prevent_household_change
before update of household_id on public.reward_logs
for each row execute function public.prevent_household_id_change();

create trigger parent_settings_prevent_household_change
before update of household_id on public.parent_settings
for each row execute function public.prevent_household_id_change();

create or replace function public.create_initial_child_balance()
returns trigger
language plpgsql
security definer
set search_path = ''
as $$
begin
  insert into public.child_balances (child_id) values (new.id);
  return new;
end;
$$;

create trigger children_create_initial_balance
after insert on public.children
for each row execute function public.create_initial_child_balance();

create or replace function public.validate_today_task_household()
returns trigger
language plpgsql
security definer
set search_path = ''
as $$
declare
  child_household_id uuid;
  task_household_id uuid;
begin
  select household_id into child_household_id from public.children where id = new.child_id;
  select household_id into task_household_id from public.tasks where id = new.task_id;
  if child_household_id is null or task_household_id is null or child_household_id <> task_household_id then
    raise exception 'today task child and task must belong to the same household';
  end if;
  return new;
end;
$$;

create trigger today_tasks_validate_household
before insert or update of child_id, task_id on public.today_tasks
for each row execute function public.validate_today_task_household();

create or replace function public.validate_help_job_applicant_household()
returns trigger
language plpgsql
security definer
set search_path = ''
as $$
declare
  child_household_id uuid;
  job_household_id uuid;
begin
  select household_id into child_household_id from public.children where id = new.child_id;
  select household_id into job_household_id from public.help_jobs where id = new.job_id;
  if child_household_id is null or job_household_id is null or child_household_id <> job_household_id then
    raise exception 'applicant child and help job must belong to the same household';
  end if;
  return new;
end;
$$;

create trigger help_job_applicants_validate_household
before insert or update of job_id, child_id on public.help_job_applicants
for each row execute function public.validate_help_job_applicant_household();

create or replace function public.validate_reward_log_child_household()
returns trigger
language plpgsql
security definer
set search_path = ''
as $$
begin
  if new.child_id is not null and not exists (
    select 1 from public.children c
    where c.id = new.child_id and c.household_id = new.household_id
  ) then
    raise exception 'reward log child must belong to the same household';
  end if;
  return new;
end;
$$;

create trigger reward_logs_validate_child_household
before insert or update of household_id, child_id on public.reward_logs
for each row execute function public.validate_reward_log_child_household();

create or replace function public.is_household_member(target_household_id uuid)
returns boolean
language sql
stable
security definer
set search_path = ''
as $$
  select auth.uid() is not null and exists (
    select 1
    from public.household_members hm
    where hm.household_id = target_household_id
      and hm.user_id = auth.uid()
  );
$$;

create or replace function public.is_household_owner(target_household_id uuid)
returns boolean
language sql
stable
security definer
set search_path = ''
as $$
  select auth.uid() is not null and (
    exists (
      select 1 from public.households h
      where h.id = target_household_id and h.owner_user_id = auth.uid()
    )
    or exists (
      select 1 from public.household_members hm
      where hm.household_id = target_household_id
        and hm.user_id = auth.uid()
        and hm.role = 'owner'
    )
  );
$$;

alter table public.households enable row level security;
alter table public.household_members enable row level security;
alter table public.children enable row level security;
alter table public.child_balances enable row level security;
alter table public.tasks enable row level security;
alter table public.today_tasks enable row level security;
alter table public.help_jobs enable row level security;
alter table public.help_job_applicants enable row level security;
alter table public.reward_logs enable row level security;
alter table public.parent_settings enable row level security;

create policy households_select_members on public.households
for select to authenticated
using (public.is_household_member(id) or owner_user_id = auth.uid());

create policy households_update_members on public.households
for update to authenticated
using (public.is_household_member(id))
with check (public.is_household_member(id));

create policy households_delete_owners on public.households
for delete to authenticated
using (public.is_household_owner(id));

create policy household_members_select_household on public.household_members
for select to authenticated
using (public.is_household_member(household_id) or public.is_household_owner(household_id));

create policy household_members_insert_owner on public.household_members
for insert to authenticated
with check (public.is_household_owner(household_id));

create policy household_members_update_owner on public.household_members
for update to authenticated
using (public.is_household_owner(household_id))
with check (public.is_household_owner(household_id));

create policy household_members_delete_owner on public.household_members
for delete to authenticated
using (public.is_household_owner(household_id) and role = 'parent');

create policy children_household_access on public.children
for all to authenticated
using (public.is_household_member(household_id))
with check (public.is_household_member(household_id));

create policy child_balances_household_access on public.child_balances
for all to authenticated
using (exists (
  select 1 from public.children c
  where c.id = child_id and public.is_household_member(c.household_id)
))
with check (exists (
  select 1 from public.children c
  where c.id = child_id and public.is_household_member(c.household_id)
));

create policy tasks_household_access on public.tasks
for all to authenticated
using (public.is_household_member(household_id))
with check (public.is_household_member(household_id));

create policy today_tasks_household_access on public.today_tasks
for all to authenticated
using (exists (
  select 1 from public.children c
  where c.id = child_id and public.is_household_member(c.household_id)
))
with check (exists (
  select 1 from public.children c
  where c.id = child_id and public.is_household_member(c.household_id)
));

create policy help_jobs_household_access on public.help_jobs
for all to authenticated
using (public.is_household_member(household_id))
with check (public.is_household_member(household_id));

create policy help_job_applicants_household_access on public.help_job_applicants
for all to authenticated
using (exists (
  select 1 from public.help_jobs j
  where j.id = job_id and public.is_household_member(j.household_id)
))
with check (exists (
  select 1 from public.help_jobs j
  where j.id = job_id and public.is_household_member(j.household_id)
));

create policy reward_logs_household_access on public.reward_logs
for all to authenticated
using (public.is_household_member(household_id))
with check (public.is_household_member(household_id));

create policy parent_settings_household_access on public.parent_settings
for all to authenticated
using (public.is_household_member(household_id))
with check (public.is_household_member(household_id));

create or replace function public.create_household(household_name text)
returns public.households
language plpgsql
security definer
set search_path = ''
as $$
declare
  created_household public.households;
begin
  if auth.uid() is null then
    raise exception 'authentication required';
  end if;
  if char_length(btrim(household_name)) not between 1 and 100 then
    raise exception 'household name must be between 1 and 100 characters';
  end if;

  insert into public.households (name, owner_user_id)
  values (btrim(household_name), auth.uid())
  returning * into created_household;

  insert into public.household_members (household_id, user_id, role)
  values (created_household.id, auth.uid(), 'owner');

  return created_household;
end;
$$;

create or replace function public.add_ticket(child_id_arg uuid, amount_arg integer, reason_arg text default null)
returns public.child_balances
language plpgsql
security definer
set search_path = ''
as $$
declare
  household_id_value uuid;
  updated_balance public.child_balances;
begin
  if amount_arg is null or amount_arg <= 0 then
    raise exception 'amount must be a positive integer';
  end if;
  select c.household_id into household_id_value from public.children c where c.id = child_id_arg;
  if household_id_value is null or not public.is_household_member(household_id_value) then
    raise exception 'child not found or access denied';
  end if;

  update public.child_balances
  set tickets = tickets + amount_arg
  where child_id = child_id_arg
  returning * into updated_balance;
  if updated_balance.child_id is null then raise exception 'child balance not found'; end if;

  insert into public.reward_logs (household_id, child_id, type, title, message, amount)
  values (household_id_value, child_id_arg, 'ticket_added', 'チケット獲得', reason_arg, amount_arg);
  return updated_balance;
end;
$$;

create or replace function public.add_star_coin(child_id_arg uuid, amount_arg integer, reason_arg text default null)
returns public.child_balances
language plpgsql
security definer
set search_path = ''
as $$
declare
  household_id_value uuid;
  updated_balance public.child_balances;
begin
  if amount_arg is null or amount_arg <= 0 then
    raise exception 'amount must be a positive integer';
  end if;
  select c.household_id into household_id_value from public.children c where c.id = child_id_arg;
  if household_id_value is null or not public.is_household_member(household_id_value) then
    raise exception 'child not found or access denied';
  end if;

  update public.child_balances
  set star_coins = star_coins + amount_arg
  where child_id = child_id_arg
  returning * into updated_balance;
  if updated_balance.child_id is null then raise exception 'child balance not found'; end if;

  insert into public.reward_logs (household_id, child_id, type, title, message, amount)
  values (household_id_value, child_id_arg, 'star_coin_added', 'スターコイン獲得', reason_arg, amount_arg);
  return updated_balance;
end;
$$;

create or replace function public.exchange_star_coins_for_ticket(child_id_arg uuid)
returns public.child_balances
language plpgsql
security definer
set search_path = ''
as $$
declare
  household_id_value uuid;
  updated_balance public.child_balances;
begin
  select c.household_id into household_id_value from public.children c where c.id = child_id_arg;
  if household_id_value is null or not public.is_household_member(household_id_value) then
    raise exception 'child not found or access denied';
  end if;

  select * into updated_balance
  from public.child_balances
  where child_id = child_id_arg
  for update;
  if updated_balance.child_id is null then raise exception 'child balance not found'; end if;
  if updated_balance.star_coins < 5 then raise exception 'at least 5 star coins are required'; end if;

  update public.child_balances
  set star_coins = star_coins - 5, tickets = tickets + 1
  where child_id = child_id_arg
  returning * into updated_balance;

  insert into public.reward_logs (household_id, child_id, type, title, message, amount, metadata)
  values (
    household_id_value,
    child_id_arg,
    'star_coin_exchange',
    'スターコイン交換',
    'スターコイン5枚をチケット1枚に交換',
    1,
    jsonb_build_object('star_coins_spent', 5, 'tickets_added', 1)
  );
  return updated_balance;
end;
$$;

create or replace function public.adjust_pay_balance(
  child_id_arg uuid,
  pay_type_arg text,
  amount_arg integer,
  reason_arg text default null
)
returns public.child_balances
language plpgsql
security definer
set search_path = ''
as $$
declare
  household_id_value uuid;
  updated_balance public.child_balances;
begin
  if pay_type_arg is null or pay_type_arg not in ('sweets', 'toy', 'game') then raise exception 'invalid pay type'; end if;
  if amount_arg is null or amount_arg = 0 then raise exception 'amount must be non-zero'; end if;
  select c.household_id into household_id_value from public.children c where c.id = child_id_arg;
  if household_id_value is null or not public.is_household_member(household_id_value) then
    raise exception 'child not found or access denied';
  end if;

  update public.child_balances
  set
    sweets_pay = sweets_pay + case when pay_type_arg = 'sweets' then amount_arg else 0 end,
    toy_pay = toy_pay + case when pay_type_arg = 'toy' then amount_arg else 0 end,
    game_pay = game_pay + case when pay_type_arg = 'game' then amount_arg else 0 end
  where child_id = child_id_arg
    and (pay_type_arg <> 'sweets' or sweets_pay + amount_arg >= 0)
    and (pay_type_arg <> 'toy' or toy_pay + amount_arg >= 0)
    and (pay_type_arg <> 'game' or game_pay + amount_arg >= 0)
  returning * into updated_balance;
  if updated_balance.child_id is null then raise exception 'balance not found or insufficient PAY balance'; end if;

  insert into public.reward_logs (household_id, child_id, type, title, message, amount, metadata)
  values (
    household_id_value,
    child_id_arg,
    'pay_adjusted',
    'PAYポイント変更',
    reason_arg,
    amount_arg,
    jsonb_build_object('pay_type', pay_type_arg)
  );
  return updated_balance;
end;
$$;

create or replace function public.complete_today_task(today_task_id_arg uuid)
returns public.today_tasks
language plpgsql
security definer
set search_path = ''
as $$
declare
  today_task_row public.today_tasks;
  task_row public.tasks;
  household_id_value uuid;
  reward_amount integer;
begin
  select * into today_task_row
  from public.today_tasks
  where id = today_task_id_arg
  for update;
  if today_task_row.id is null then raise exception 'today task not found'; end if;

  select c.household_id into household_id_value
  from public.children c
  where c.id = today_task_row.child_id;
  if household_id_value is null or not public.is_household_member(household_id_value) then
    raise exception 'access denied';
  end if;
  if today_task_row.reward_granted then raise exception 'reward has already been granted'; end if;
  if today_task_row.status = 'cancelled' then raise exception 'cancelled task cannot be completed'; end if;

  select * into task_row from public.tasks where id = today_task_row.task_id for share;
  if task_row.id is null then raise exception 'task not found'; end if;
  if task_row.household_id <> household_id_value then raise exception 'task household mismatch'; end if;

  if task_row.reward_type = 'ticket' then
    reward_amount := task_row.ticket_reward;
    update public.child_balances set tickets = tickets + reward_amount where child_id = today_task_row.child_id;
  else
    reward_amount := task_row.star_coin_reward;
    update public.child_balances set star_coins = star_coins + reward_amount where child_id = today_task_row.child_id;
  end if;
  if not found then raise exception 'child balance not found'; end if;

  update public.today_tasks
  set status = 'completed', completed_at = coalesce(completed_at, now()), reward_granted = true
  where id = today_task_id_arg
  returning * into today_task_row;

  insert into public.reward_logs (household_id, child_id, type, title, message, amount, metadata)
  values (
    household_id_value,
    today_task_row.child_id,
    'today_task_reward',
    task_row.title,
    '今日のお手伝い完了報酬',
    reward_amount,
    jsonb_build_object('today_task_id', today_task_row.id, 'task_id', task_row.id, 'reward_type', task_row.reward_type)
  );
  return today_task_row;
end;
$$;

create or replace function public.approve_help_job_reward(applicant_id_arg uuid)
returns public.help_job_applicants
language plpgsql
security definer
set search_path = ''
as $$
declare
  applicant_row public.help_job_applicants;
  job_row public.help_jobs;
  household_id_value uuid;
  reward_amount integer;
begin
  select * into applicant_row
  from public.help_job_applicants
  where id = applicant_id_arg
  for update;
  if applicant_row.id is null then raise exception 'applicant not found'; end if;

  select * into job_row from public.help_jobs where id = applicant_row.job_id for share;
  household_id_value := job_row.household_id;
  if household_id_value is null or not public.is_household_member(household_id_value) then
    raise exception 'access denied';
  end if;
  if applicant_row.reward_granted then raise exception 'reward has already been granted'; end if;
  if applicant_row.status <> 'completed' then raise exception 'applicant must be completed before approval'; end if;
  if not exists (
    select 1 from public.children c
    where c.id = applicant_row.child_id
      and c.household_id = household_id_value
  ) then
    raise exception 'applicant child must belong to the job household';
  end if;

  if job_row.reward_type = 'ticket' then
    reward_amount := job_row.ticket_reward;
    update public.child_balances set tickets = tickets + reward_amount where child_id = applicant_row.child_id;
  else
    reward_amount := job_row.star_coin_reward;
    update public.child_balances set star_coins = star_coins + reward_amount where child_id = applicant_row.child_id;
  end if;
  if not found then raise exception 'child balance not found'; end if;

  update public.help_job_applicants
  set status = 'approved', approved_at = now(), reward_granted = true
  where id = applicant_id_arg
  returning * into applicant_row;

  insert into public.reward_logs (household_id, child_id, type, title, message, amount, metadata)
  values (
    household_id_value,
    applicant_row.child_id,
    'help_job_reward',
    job_row.title,
    'お手伝い掲示板の報酬を承認',
    reward_amount,
    jsonb_build_object('job_id', job_row.id, 'applicant_id', applicant_row.id, 'reward_type', job_row.reward_type)
  );
  return applicant_row;
end;
$$;

revoke all on
  public.households,
  public.household_members,
  public.children,
  public.child_balances,
  public.tasks,
  public.today_tasks,
  public.help_jobs,
  public.help_job_applicants,
  public.reward_logs,
  public.parent_settings
from anon, authenticated;
grant select, insert, update, delete on
  public.household_members,
  public.children,
  public.tasks,
  public.today_tasks,
  public.help_jobs,
  public.help_job_applicants,
  public.parent_settings
to authenticated;

grant select, update, delete on public.households to authenticated;
grant select on public.child_balances, public.reward_logs to authenticated;

revoke insert, update on public.today_tasks from authenticated;
grant insert (child_id, task_id, status, created_at, completed_at) on public.today_tasks to authenticated;
grant update (status, completed_at) on public.today_tasks to authenticated;

revoke insert, update, delete on public.help_job_applicants from authenticated;
grant insert (job_id, child_id, status, applied_at, completed_at) on public.help_job_applicants to authenticated;
grant update (status, completed_at) on public.help_job_applicants to authenticated;

revoke execute on function public.set_updated_at() from public, anon, authenticated;
revoke execute on function public.prevent_household_owner_change() from public, anon, authenticated;
revoke execute on function public.prevent_household_id_change() from public, anon, authenticated;
revoke execute on function public.create_initial_child_balance() from public, anon, authenticated;
revoke execute on function public.validate_today_task_household() from public, anon, authenticated;
revoke execute on function public.validate_help_job_applicant_household() from public, anon, authenticated;
revoke execute on function public.validate_reward_log_child_household() from public, anon, authenticated;
revoke execute on function public.validate_household_member_role() from public, anon, authenticated;

revoke execute on function public.is_household_member(uuid) from public, anon;
revoke execute on function public.is_household_owner(uuid) from public, anon;
grant execute on function public.is_household_member(uuid) to authenticated;
grant execute on function public.is_household_owner(uuid) to authenticated;

revoke execute on function public.create_household(text) from public, anon;
revoke execute on function public.add_ticket(uuid, integer, text) from public, anon;
revoke execute on function public.add_star_coin(uuid, integer, text) from public, anon;
revoke execute on function public.exchange_star_coins_for_ticket(uuid) from public, anon;
revoke execute on function public.adjust_pay_balance(uuid, text, integer, text) from public, anon;
revoke execute on function public.complete_today_task(uuid) from public, anon;
revoke execute on function public.approve_help_job_reward(uuid) from public, anon;

grant execute on function public.create_household(text) to authenticated;
grant execute on function public.add_ticket(uuid, integer, text) to authenticated;
grant execute on function public.add_star_coin(uuid, integer, text) to authenticated;
grant execute on function public.exchange_star_coins_for_ticket(uuid) to authenticated;
grant execute on function public.adjust_pay_balance(uuid, text, integer, text) to authenticated;
grant execute on function public.complete_today_task(uuid) to authenticated;
grant execute on function public.approve_help_job_reward(uuid) to authenticated;

commit;
